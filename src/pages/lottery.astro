---
import Layout from '@/components/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import casesData from '@/data/default-cases.json';

const cases = casesData.cases;
---

<Layout 
  title="CS2抽奖模拟器"
  description="CS2风格的开箱抽奖模拟器"
>
  <Header currentPage="/lottery" />
  
  <main class="lottery-page">
    <div class="container">
      <h1>CS2 抽奖模拟器</h1>
      <p class="subtitle">选择一个箱子开始开箱</p>
      
      <div class="balance-info">
        <div class="balance">
          <span class="label">余额:</span>
          <span class="amount" id="balance-amount">$100.00</span>
        </div>
        <div class="profit-loss">
          <span class="label">盈亏:</span>
          <span class="amount" id="profit-amount">$0.00</span>
        </div>
      </div>
      
      <div class="cases-grid">
        {cases.map((caseItem) => (
          <div class="case-card" data-case-id={caseItem.id}>
            <img 
              src={caseItem.image} 
              alt={caseItem.name} 
              class="case-image"
              onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22250%22 height=%22200%22><rect fill=%22%230a0a0a%22 width=%22250%22 height=%22200%22/><text x=%2250%%22 y=%2250%%22 fill=%22%23888%22 text-anchor=%22middle%22 dy=%22.3em%22>暂无图片</text></svg>'"
            />
            <h3 class="case-name">{caseItem.name}</h3>
            <p class="case-price">${caseItem.price.toFixed(2)}</p>
            <button class="open-case-btn">开箱</button>
          </div>
        ))}
      </div>
      
      <div class="lottery-wheel-container" id="lottery-wheel" style="display: none;">
        <div class="wheel-wrapper">
          <div class="wheel-pointer">▼</div>
          <div class="wheel-items" id="wheel-items">
            <!-- 动态生成的奖品卡片 -->
          </div>
        </div>
      </div>
      
      <div class="result-modal" id="result-modal" style="display: none;">
        <div class="modal-content">
          <img src="" alt="" class="result-image" id="result-image" />
          <h2 class="result-name" id="result-name"></h2>
          <p class="result-rarity" id="result-rarity"></p>
          <p class="result-price" id="result-price"></p>
          <button class="close-modal-btn" id="close-modal">关闭</button>
        </div>
      </div>
    </div>
  </main>
  
  <Footer />
</Layout>

<style>
  .lottery-page {
    flex: 1;
    padding: 2rem;
    min-height: calc(100vh - 200px);
  }
  
  .container {
    max-width: 1200px;
    margin: 0 auto;
  }
  
  h1 {
    font-size: 3rem;
    text-align: center;
    margin-bottom: 0.5rem;
    color: var(--color-primary);
    text-shadow: 0 0 30px rgba(228, 78, 0, 0.5);
  }
  
  .subtitle {
    text-align: center;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }
  
  .balance-info {
    display: flex;
    justify-content: center;
    gap: 3rem;
    margin-bottom: 3rem;
    padding: 1.5rem;
    background: rgba(228, 78, 0, 0.1);
    border-radius: 8px;
    border: 1px solid rgba(228, 78, 0, 0.3);
  }
  
  .balance, .profit-loss {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  
  .label {
    color: var(--color-text-muted);
    font-size: 1rem;
  }
  
  .amount {
    font-size: 1.5rem;
    font-weight: bold;
    color: var(--color-text);
  }
  
  .cases-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
  }
  
  .case-card {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 1.5rem;
    text-align: center;
    transition: all 0.3s;
    border: 1px solid rgba(255, 255, 255, 0.1);
    cursor: pointer;
  }
  
  .case-card:hover {
    transform: translateY(-5px);
    border-color: var(--color-primary);
    box-shadow: 0 10px 30px rgba(228, 78, 0, 0.3);
  }
  
  .case-card.selected {
    border-color: var(--color-primary);
    box-shadow: 0 0 30px rgba(228, 78, 0, 0.5);
  }
  
  .case-image {
    width: 100%;
    height: 200px;
    object-fit: contain;
    margin-bottom: 1rem;
  }
  
  .case-name {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }
  
  .case-price {
    font-size: 1.5rem;
    font-weight: bold;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }
  
  .open-case-btn {
    width: 100%;
    padding: 0.75rem 1.5rem;
    background: var(--color-primary);
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.3s;
  }
  
  .open-case-btn:hover {
    background: rgba(228, 78, 0, 0.8);
    box-shadow: 0 0 20px rgba(228, 78, 0, 0.5);
  }
  
  .lottery-wheel-container {
    position: relative;
    width: 100%;
    height: 200px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.5);
    border-radius: 12px;
    margin-bottom: 2rem;
  }
  
  .wheel-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
  }
  
  .wheel-pointer {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    font-size: 2rem;
    color: var(--color-primary);
    z-index: 10;
    text-shadow: 0 0 10px rgba(228, 78, 0, 0.8);
  }
  
  .wheel-items {
    display: flex;
    gap: 10px;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    padding: 0 50%;
  }
  
  .wheel-item {
    flex-shrink: 0;
    width: 100px;
    height: 100px;
    background: rgba(0, 0, 0, 0.5);
    border: 2px solid;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5px;
  }
  
  .wheel-item img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  
  .result-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
  }
  
  .modal-content {
    background: var(--color-background);
    padding: 3rem;
    border-radius: 16px;
    text-align: center;
    border: 2px solid var(--color-primary);
    box-shadow: 0 0 50px rgba(228, 78, 0, 0.5);
  }
  
  .result-image {
    width: 300px;
    height: 200px;
    object-fit: contain;
    margin-bottom: 1.5rem;
  }
  
  .result-name {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }
  
  .result-rarity {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }
  
  .result-price {
    font-size: 1.5rem;
    font-weight: bold;
    color: var(--color-primary);
    margin-bottom: 2rem;
  }
  
  .close-modal-btn {
    padding: 0.75rem 2rem;
    background: var(--color-primary);
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s;
  }
  
  .close-modal-btn:hover {
    background: rgba(228, 78, 0, 0.8);
  }
</style>

<script>
  import { StorageManager } from '@/scripts/storage-manager';
  import { LotteryEngine } from '@/scripts/lottery-engine';
  import { EconomySystem } from '@/scripts/economy-system';
  import { RarityColors, RarityNames } from '@/types/rarity';
  import type { Case, CaseItem } from '@/types/case';

  const storage = StorageManager.getInstance();
  const lottery = new LotteryEngine();
  const economy = new EconomySystem();

  let selectedCase: Case | null = null;
  let isSpinning = false;

  function updateBalanceDisplay() {
    const balance = economy.getBalance();
    const profitLoss = economy.getProfitLoss();
    
    const balanceEl = document.getElementById('balance-amount');
    const profitEl = document.getElementById('profit-amount');
    
    if (balanceEl) balanceEl.textContent = `$${balance.toFixed(2)}`;
    if (profitEl) {
      profitEl.textContent = `${profitLoss >= 0 ? '+' : ''}$${profitLoss.toFixed(2)}`;
      profitEl.style.color = profitLoss >= 0 ? '#4caf50' : '#f44336';
    }
  }

  function selectCase(caseId: string) {
    const cases = storage.getCases();
    selectedCase = cases.find(c => c.id === caseId) || null;
    
    if (selectedCase) {
      document.querySelectorAll('.case-card').forEach(card => {
        card.classList.remove('selected');
      });
      document.querySelector(`[data-case-id="${caseId}"]`)?.classList.add('selected');
    }
  }

  async function openCase() {
    if (!selectedCase || isSpinning) return;
    
    const totalCost = selectedCase.price + selectedCase.keyPrice;
    
    if (!economy.canAfford(totalCost)) {
      alert(`余额不足！需要 $${totalCost.toFixed(2)}`);
      return;
    }

    if (selectedCase.items.length === 0) {
      alert('这个箱子还没有配置奖品！');
      return;
    }

    isSpinning = true;
    economy.spend(totalCost, `开箱: ${selectedCase.name}`, selectedCase.id);
    updateBalanceDisplay();

    const wheelItems = lottery.generateWheelItems(selectedCase.items, 50);
    const winningItem = wheelItems[Math.floor(wheelItems.length / 2)];

    await showWheelAnimation(wheelItems, winningItem);
    showResult(winningItem);

    isSpinning = false;
  }

  async function showWheelAnimation(items: CaseItem[], winningItem: CaseItem): Promise<void> {
    return new Promise((resolve) => {
      const wheelContainer = document.getElementById('lottery-wheel') as HTMLElement;
      const wheelItems = document.getElementById('wheel-items') as HTMLElement;
      
      wheelContainer.style.display = 'block';
      
      wheelItems.innerHTML = items.map((item, index) => `
        <div class="wheel-item" style="border-color: ${RarityColors[item.rarity]}">
          <img src="${item.image}" alt="${item.name}" />
        </div>
      `).join('');

      const itemWidth = 120;
      const totalWidth = items.length * itemWidth;
      const containerWidth = wheelContainer.offsetWidth;
      const winningIndex = Math.floor(items.length / 2);
      const scrollPosition = (winningIndex * itemWidth) - (containerWidth / 2) + (itemWidth / 2);

      wheelItems.style.transition = 'transform 5s cubic-bezier(0.25, 0.1, 0.25, 1)';
      wheelItems.style.transform = `translateX(-${scrollPosition}px)`;

      setTimeout(() => {
        resolve();
      }, 5000);
    });
  }

  function showResult(item: CaseItem) {
    const modal = document.getElementById('result-modal') as HTMLElement;
    const image = document.getElementById('result-image') as HTMLImageElement;
    const name = document.getElementById('result-name') as HTMLElement;
    const rarity = document.getElementById('result-rarity') as HTMLElement;
    const price = document.getElementById('result-price') as HTMLElement;

    image.src = item.inspectImage || item.image;
    name.textContent = item.name;
    rarity.textContent = RarityNames[item.rarity];
    rarity.style.color = RarityColors[item.rarity];
    price.textContent = `$${item.price.toFixed(2)}`;

    modal.style.display = 'flex';

    const inventoryItem: any = {
      ...item,
      obtainedAt: new Date(),
      caseId: selectedCase!.id,
      caseName: selectedCase!.name
    };
    economy.addToInventory(inventoryItem);

    const historyRecord: any = {
      id: `${Date.now()}_${Math.random().toString(36).substr(2, 9)}`,
      caseId: selectedCase!.id,
      caseName: selectedCase!.name,
      item,
      timestamp: new Date()
    };
    economy.addHistory(historyRecord);
  }

  document.querySelectorAll('.case-card').forEach(card => {
    card.addEventListener('click', () => {
      const caseId = card.getAttribute('data-case-id');
      if (caseId) selectCase(caseId);
    });

    const btn = card.querySelector('.open-case-btn');
    if (btn) {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const caseId = card.getAttribute('data-case-id');
        if (caseId) {
          selectCase(caseId);
          openCase();
        }
      });
    }
  });

  document.getElementById('close-modal')?.addEventListener('click', () => {
    (document.getElementById('result-modal') as HTMLElement).style.display = 'none';
    (document.getElementById('lottery-wheel') as HTMLElement).style.display = 'none';
  });

  updateBalanceDisplay();

  console.log('CS2抽奖模拟器已加载');
  console.log('可用箱子:', cases);
</script>
