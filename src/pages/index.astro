    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
  }
  nav a:hover {
    color: #e44e00;
  }
  main {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem;
  }
  h1 {
    font-size: 4rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
  }
  p {
    font-size: 1.2rem;
    color: #888;
    margin-bottom: 0.25rem;
  }
  footer {
    padding: 2rem;
    text-align: center;
    font-size: 0.8rem;
    color: #555;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .social-links {
    display: flex;
    gap: 1rem;
  }
  .social-links a {
    color: #555;
    transition: color 0.2s;
  }
  .social-links a:hover {
    color: #e0e0e0;
  }
</style>
