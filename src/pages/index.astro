---
import Layout from '@/components/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
---

<Layout 
  title="Kiem - Game Developer" 
  description="Kiem's Portfolio - Game Developer"
  showParticles={true}
  showBackToTop={true}
  customCursor={true}
>
  <Header currentPage="/" />
  
  <main>
    <h1 class="typewriter" data-text="Kiem">Kiem</h1>
    <p>Game Developer | Godot | Python</p>
    <p>Welcome to my portfolio!</p>
  </main>
  
  <Footer showSocialLinks={true} year={2026} />
</Layout>

<style>
  main {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem;
  }
  
  h1 {
    font-size: 4rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
    text-shadow: 0 0 30px rgba(228, 78, 0, 0.5);
  }
  
  p {
    font-size: 1.2rem;
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
  }
</style>

<script>
  const title = document.querySelector('.typewriter');
  if (title) {
    const text = title.getAttribute('data-text');
    title.textContent = '';
    let i = 0;
    function type() {
      if (i < text.length) {
        title.textContent += text.charAt(i);
        i++;
        setTimeout(type, 100);
      }
    }
    setTimeout(type, 500);
  }
</script>
