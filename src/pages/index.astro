    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }
  header {
    padding: 2rem;
    display: flex;
    justify-content: center;
  }
  nav {
    display: flex;
    gap: 2rem;
  }
  nav a {
