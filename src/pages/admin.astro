---
import Layout from '@/components/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
---

<Layout 
  title="管理界面 - CS2抽奖模拟器"
  description="CS2抽奖模拟器管理界面"
>
  <Header currentPage="/admin" />
  
  <main class="admin-page">
    <div class="container">
      <h1>管理界面</h1>
      <p class="subtitle">配置箱子、奖品和概率</p>
      
      <div class="admin-tabs">
        <button class="tab-btn active" data-tab="cases">箱子管理</button>
        <button class="tab-btn" data-tab="data">数据管理</button>
        <button class="tab-btn" data-tab="settings">设置</button>
      </div>
      
      <div class="tab-content active" id="cases-tab">
        <div class="section-header">
          <h2>箱子列表</h2>
          <button class="btn-primary" id="add-case-btn">+ 添加箱子</button>
        </div>
        
        <div class="cases-list" id="cases-list">
          <div class="empty-state">
            <p>暂无箱子配置</p>
            <p class="hint">点击"添加箱子"开始配置</p>
          </div>
        </div>
      </div>
      
      <div class="tab-content" id="data-tab">
        <div class="section-header">
          <h2>数据管理</h2>
        </div>
        
        <div class="data-actions">
          <div class="action-card">
            <h3>导出配置</h3>
            <p>将当前配置导出为JSON文件</p>
            <button class="btn-secondary" id="export-config-btn">导出配置</button>
          </div>
          
          <div class="action-card">
            <h3>导入配置</h3>
            <p>从JSON文件导入配置</p>
            <input type="file" id="import-config-input" accept=".json" style="display: none;" />
            <button class="btn-secondary" id="import-config-btn">导入配置</button>
          </div>
          
          <div class="action-card">
            <h3>重置配置</h3>
            <p>恢复为默认配置</p>
            <button class="btn-danger" id="reset-config-btn">重置配置</button>
          </div>
        </div>
      </div>
      
      <div class="tab-content" id="settings-tab">
        <div class="section-header">
          <h2>系统设置</h2>
        </div>
        
        <div class="settings-form">
          <div class="form-group">
            <label>初始余额</label>
            <input type="number" id="initial-balance" value="100" step="0.01" />
          </div>
          
          <div class="form-group">
            <label>
              <input type="checkbox" id="sound-enabled" checked />
              启用音效
            </label>
          </div>
          
          <div class="form-group">
            <label>
              <input type="checkbox" id="animation-enabled" checked />
              启用动画
            </label>
          </div>
          
          <button class="btn-primary" id="save-settings-btn">保存设置</button>
        </div>
      </div>
    </div>
  </main>
  
  <div class="modal" id="case-modal" style="display: none;">
    <div class="modal-content">
      <h2 id="modal-title">添加箱子</h2>
      
      <form id="case-form">
        <div class="form-group">
          <label>箱子名称 *</label>
          <input type="text" id="case-name" required />
        </div>
        
        <div class="form-group">
          <label>箱子价格 (USD) *</label>
          <input type="number" id="case-price" step="0.01" required />
        </div>
        
        <div class="form-group">
          <label>钥匙价格 (USD) *</label>
          <input type="number" id="key-price" step="0.01" required />
        </div>
        
        <div class="form-group">
          <label>箱子图片</label>
          <input type="file" id="case-image" accept="image/*" />
          <div class="image-preview" id="case-image-preview"></div>
        </div>
        
        <div class="form-group">
          <label>或输入图片URL</label>
          <input type="url" id="case-image-url" placeholder="https://..." />
        </div>
        
        <div class="modal-actions">
          <button type="button" class="btn-secondary" id="cancel-case-btn">取消</button>
          <button type="submit" class="btn-primary">保存</button>
        </div>
      </form>
    </div>
  </div>
  
  <div class="modal" id="items-modal" style="display: none;">
    <div class="modal-content items-modal-content">
      <h2 id="items-modal-title">管理奖品</h2>
      <p class="modal-subtitle" id="items-case-name"></p>
      
      <div class="items-header">
        <h3>奖品列表</h3>
        <button class="btn-primary" id="add-item-btn">+ 添加奖品</button>
      </div>
      
      <div class="items-list" id="items-list">
        <div class="empty-state">
          <p>暂无奖品</p>
          <p class="hint">点击"添加奖品"开始配置</p>
        </div>
      </div>
      
      <div class="modal-actions">
        <button class="btn-secondary" id="close-items-btn">关闭</button>
      </div>
    </div>
  </div>
  
  <div class="modal" id="item-modal" style="display: none;">
    <div class="modal-content">
      <h2 id="item-modal-title">添加奖品</h2>
      
      <form id="item-form">
        <div class="form-group">
          <label>奖品名称 *</label>
          <input type="text" id="item-name" required />
        </div>
        
        <div class="form-group">
          <label>类型 *</label>
          <select id="item-type" required>
            <option value="weapon">武器</option>
            <option value="knife">刀</option>
            <option value="gloves">手套</option>
            <option value="other">其他</option>
          </select>
        </div>
        
        <div class="form-group">
          <label>稀有度 *</label>
          <select id="item-rarity" required>
            <option value="consumer">消费级（白）</option>
            <option value="industrial">工业级（灰）</option>
            <option value="mil_spec">军规级（蓝）</option>
            <option value="restricted">受限（紫）</option>
            <option value="classified">保密（粉紫）</option>
            <option value="covert">隐秘（红）</option>
            <option value="special">特殊物品（金）</option>
          </select>
        </div>
        
        <div class="form-group">
          <label>概率 (%) *</label>
          <input type="number" id="item-probability" step="0.01" min="0" max="100" required />
        </div>
        
        <div class="form-group">
          <label>价格 (USD) *</label>
          <input type="number" id="item-price" step="0.01" min="0" required />
        </div>
        
        <div class="form-group">
          <label>收藏品</label>
          <input type="text" id="item-collection" />
        </div>
        
        <div class="form-group">
          <label>奖品图片</label>
          <input type="file" id="item-image" accept="image/*" />
          <div class="image-preview" id="item-image-preview"></div>
        </div>
        
        <div class="form-group">
          <label>或输入图片URL</label>
          <input type="url" id="item-image-url" placeholder="https://..." />
        </div>
        
        <div class="form-group">
          <label>检视图片</label>
          <input type="file" id="item-inspect-image" accept="image/*" />
          <div class="image-preview" id="item-inspect-image-preview"></div>
        </div>
        
        <div class="form-group">
          <label>或输入检视图片URL</label>
          <input type="url" id="item-inspect-image-url" placeholder="https://..." />
        </div>
        
        <div class="modal-actions">
          <button type="button" class="btn-secondary" id="cancel-item-btn">取消</button>
          <button type="submit" class="btn-primary">保存</button>
        </div>
      </form>
    </div>
  </div>
  
  <Footer />
</Layout>

<style>
  .admin-page {
    flex: 1;
    padding: 2rem;
    min-height: calc(100vh - 200px);
  }
  
  .container {
    max-width: 1200px;
    margin: 0 auto;
  }
  
  h1 {
    font-size: 3rem;
    text-align: center;
    margin-bottom: 0.5rem;
    color: var(--color-primary);
    text-shadow: 0 0 30px rgba(228, 78, 0, 0.5);
  }
  
  .subtitle {
    text-align: center;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }
  
  .admin-tabs {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
    border-bottom: 2px solid rgba(255, 255, 255, 0.1);
    padding-bottom: 1rem;
  }
  
  .tab-btn {
    padding: 0.75rem 1.5rem;
    background: transparent;
    color: var(--color-text-muted);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.3s;
    font-size: 1rem;
  }
  
  .tab-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  
  .tab-btn.active {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
  }
  
  .tab-content {
    display: none;
  }
  
  .tab-content.active {
    display: block;
  }
  
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }
  
  .section-header h2 {
    font-size: 1.5rem;
    color: var(--color-text);
  }
  
  .btn-primary {
    padding: 0.75rem 1.5rem;
    background: var(--color-primary);
    color: white;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-size: 1rem;
    font-weight: bold;
    transition: all 0.3s;
  }
  
  .btn-primary:hover {
    background: rgba(228, 78, 0, 0.8);
    box-shadow: 0 0 20px rgba(228, 78, 0, 0.5);
  }
  
  .btn-secondary {
    padding: 0.75rem 1.5rem;
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-text-muted);
    border-radius: 8px;
    cursor: pointer;
    font-size: 1rem;
    transition: all 0.3s;
  }
  
  .btn-secondary:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  
  .btn-danger {
    padding: 0.75rem 1.5rem;
    background: rgba(220, 53, 69, 0.8);
    color: white;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-size: 1rem;
    transition: all 0.3s;
  }
  
  .btn-danger:hover {
    background: rgba(220, 53, 69, 1);
  }
  
  .cases-list {
    display: grid;
    gap: 1.5rem;
  }
  
  .case-item {
    display: flex;
    gap: 1.5rem;
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: all 0.3s;
  }
  
  .case-item:hover {
    border-color: var(--color-primary);
    box-shadow: 0 0 20px rgba(228, 78, 0, 0.2);
  }
  
  .case-thumb {
    width: 120px;
    height: 120px;
    object-fit: contain;
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.3);
  }
  
  .case-info {
    flex: 1;
  }
  
  .case-info h3 {
    font-size: 1.3rem;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }
  
  .case-info p {
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
    font-size: 0.9rem;
  }
  
  .case-actions {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    justify-content: center;
  }
  
  .btn-edit {
    padding: 0.5rem 1rem;
    background: rgba(228, 78, 0, 0.2);
    color: var(--color-primary);
    border: 1px solid var(--color-primary);
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.3s;
    font-size: 0.9rem;
  }
  
  .btn-edit:hover {
    background: var(--color-primary);
    color: white;
  }
  
  .btn-delete {
    padding: 0.5rem 1rem;
    background: rgba(220, 53, 69, 0.2);
    color: #dc3545;
    border: 1px solid #dc3545;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.3s;
    font-size: 0.9rem;
  }
  
  .btn-delete:hover {
    background: #dc3545;
    color: white;
  }
  
  .empty-state {
    text-align: center;
    padding: 3rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    color: var(--color-text-muted);
  }
  
  .empty-state .hint {
    font-size: 0.9rem;
    margin-top: 0.5rem;
  }
  
  .data-actions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }
  
  .action-card {
    background: rgba(255, 255, 255, 0.05);
    padding: 1.5rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  
  .action-card h3 {
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }
  
  .action-card p {
    color: var(--color-text-muted);
    margin-bottom: 1rem;
    font-size: 0.9rem;
  }
  
  .settings-form {
    max-width: 500px;
    background: rgba(255, 255, 255, 0.05);
    padding: 2rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  
  .form-group {
    margin-bottom: 1.5rem;
  }
  
  .form-group label {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--color-text);
    font-weight: 500;
  }
  
  .form-group input[type="text"],
  .form-group input[type="number"],
  .form-group input[type="url"] {
    width: 100%;
    padding: 0.75rem;
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: var(--color-text);
    font-size: 1rem;
  }
  
  .form-group input[type="file"] {
    width: 100%;
    padding: 0.5rem;
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: var(--color-text);
  }
  
  .form-group input[type="checkbox"] {
    margin-right: 0.5rem;
  }
  
  .image-preview {
    margin-top: 1rem;
    text-align: center;
  }
  
  .image-preview img {
    max-width: 200px;
    max-height: 200px;
    border-radius: 8px;
  }
  
  .modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
  }
  
  .modal .modal-content {
    background: var(--color-background);
    padding: 2rem;
    border-radius: 16px;
    border: 1px solid var(--color-primary);
    max-width: 500px;
    width: 90%;
    max-height: 90vh;
    overflow-y: auto;
  }
  
  .modal h2 {
    margin-bottom: 1.5rem;
    color: var(--color-primary);
  }
  
  .modal-actions {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
  }
  
  .modal-actions button {
    flex: 1;
  }
  
  .items-modal-content {
    max-width: 900px;
    max-height: 80vh;
    overflow-y: auto;
  }
  
  .modal-subtitle {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }
  
  .items-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }
  
  .items-list {
    display: grid;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  
  .item-entry {
    display: flex;
    gap: 1rem;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    align-items: center;
  }
  
  .item-entry img {
    width: 60px;
    height: 60px;
    object-fit: contain;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.3);
  }
  
  .item-entry-info {
    flex: 1;
  }
  
  .item-entry-name {
    font-weight: bold;
    margin-bottom: 0.25rem;
  }
  
  .item-entry-details {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  
  .item-entry-actions {
    display: flex;
    gap: 0.5rem;
  }
  
  .btn-manage {
    padding: 0.5rem 1rem;
    background: rgba(76, 175, 80, 0.2);
    color: #4caf50;
    border: 1px solid #4caf50;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.3s;
    font-size: 0.9rem;
  }
  
  .btn-manage:hover {
    background: #4caf50;
    color: white;
  }
  
  .probability-check {
    font-size: 0.85rem;
    font-weight: bold;
    margin-top: 0.25rem;
  }
  
  .probability-check.valid {
    color: #4caf50;
  }
  
  .probability-check.invalid {
    color: #f44336;
  }
  
  select {
    width: 100%;
    padding: 0.75rem;
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: var(--color-text);
    font-size: 1rem;
    cursor: pointer;
  }
  
  select option {
    background: var(--color-background);
    color: var(--color-text);
  }
</style>

<script>
  import { StorageManager } from '@/scripts/storage-manager';
  import { AdminManager } from '@/scripts/admin-manager';
  import { LotteryEngine } from '@/scripts/lottery-engine';
  import { RarityColors, RarityNames } from '@/types/rarity';
  import type { Case } from '@/types/case';
  import type { CaseItem } from '@/types/item';

  const storage = StorageManager.getInstance();
  const admin = new AdminManager();
  const lottery = new LotteryEngine();

  let editingCaseId: string | null = null;
  let editingItemId: string | null = null;
  let currentCaseId: string | null = null;

  function loadCases() {
    const cases = storage.getCases();
    const casesList = document.getElementById('cases-list')!;
    
    if (cases.length === 0) {
      casesList.innerHTML = `
        <div class="empty-state">
          <p>暂无箱子配置</p>
          <p class="hint">点击"添加箱子"开始配置</p>
        </div>
      `;
      return;
    }

    casesList.innerHTML = cases.map(caseItem => `
      <div class="case-item" data-id="${caseItem.id}">
        <img src="${caseItem.image}" alt="${caseItem.name}" class="case-thumb" 
             onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22120%22 height=%22120%22><rect fill=%22%230a0a0a%22 width=%22120%22 height=%22120%22/><text x=%2250%%22 y=%2250%%22 fill=%22%23888%22 text-anchor=%22middle%22 dy=%22.3em%22 font-size=%2212%22>暂无图片</text></svg>'" />
        <div class="case-info">
          <h3>${caseItem.name}</h3>
          <p>价格: $${caseItem.price.toFixed(2)}</p>
          <p>钥匙: $${caseItem.keyPrice.toFixed(2)}</p>
          <p>奖品数: ${caseItem.items.length}</p>
          ${caseItem.items.length > 0 ? `<p class="probability-check ${lottery.validateProbabilities(caseItem.items) ? 'valid' : 'invalid'}">
            概率: ${caseItem.items.reduce((sum, item) => sum + item.probability, 0).toFixed(2)}%
            ${lottery.validateProbabilities(caseItem.items) ? '✓' : '✗ (需等于100%)'}
          </p>` : ''}
        </div>
        <div class="case-actions">
          <button class="btn-manage" onclick="manageItems('${caseItem.id}')">管理奖品</button>
          <button class="btn-edit" onclick="editCase('${caseItem.id}')">编辑</button>
          <button class="btn-delete" onclick="deleteCase('${caseItem.id}')">删除</button>
        </div>
      </div>
    `).join('');
  }

  (window as any).editCase = (id: string) => {
    const cases = storage.getCases();
    const caseItem = cases.find(c => c.id === id);
    if (!caseItem) return;

    editingCaseId = id;
    (document.getElementById('modal-title') as HTMLElement).textContent = '编辑箱子';
    (document.getElementById('case-name') as HTMLInputElement).value = caseItem.name;
    (document.getElementById('case-price') as HTMLInputElement).value = caseItem.price.toString();
    (document.getElementById('key-price') as HTMLInputElement).value = caseItem.keyPrice.toString();
    (document.getElementById('case-image-url') as HTMLInputElement).value = caseItem.image;
    
    const preview = document.getElementById('case-image-preview') as HTMLElement;
    preview.innerHTML = `<img src="${caseItem.image}" alt="预览" />`;
    
    (document.getElementById('case-modal') as HTMLElement).style.display = 'flex';
  };

  (window as any).deleteCase = (id: string) => {
    if (confirm('确定要删除这个箱子吗？')) {
      admin.deleteCase(id);
      loadCases();
    }
  };

  document.getElementById('add-case-btn')?.addEventListener('click', () => {
    editingCaseId = null;
    (document.getElementById('modal-title') as HTMLElement).textContent = '添加箱子';
    (document.getElementById('case-form') as HTMLFormElement).reset();
    (document.getElementById('case-image-preview') as HTMLElement).innerHTML = '';
    (document.getElementById('case-modal') as HTMLElement).style.display = 'flex';
  });

  document.getElementById('cancel-case-btn')?.addEventListener('click', () => {
    (document.getElementById('case-modal') as HTMLElement).style.display = 'none';
  });

  document.getElementById('case-image')?.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) {
      const base64 = await admin.imageToBase64(file);
      const preview = document.getElementById('case-image-preview') as HTMLElement;
      preview.innerHTML = `<img src="${base64}" alt="预览" />`;
      (document.getElementById('case-image-url') as HTMLInputElement).value = base64;
    }
  });

  document.getElementById('case-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    
    const name = (document.getElementById('case-name') as HTMLInputElement).value;
    const price = parseFloat((document.getElementById('case-price') as HTMLInputElement).value);
    const keyPrice = parseFloat((document.getElementById('key-price') as HTMLInputElement).value);
    const image = (document.getElementById('case-image-url') as HTMLInputElement).value;

    if (editingCaseId) {
      const cases = storage.getCases();
      const existingCase = cases.find(c => c.id === editingCaseId);
      if (existingCase) {
        const updatedCase: Case = {
          ...existingCase,
          name,
          price,
          keyPrice,
          image,
          updatedAt: new Date()
        };
        admin.updateCase(editingCaseId, updatedCase);
      }
    } else {
      const newCase = admin.createCase(name, price, keyPrice, image);
      admin.addCase(newCase);
    }

    (document.getElementById('case-modal') as HTMLElement).style.display = 'none';
    loadCases();
  });

  document.getElementById('export-config-btn')?.addEventListener('click', () => {
    const config = admin.exportConfig();
    const blob = new Blob([config], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'cs2-lottery-config.json';
    a.click();
    URL.revokeObjectURL(url);
  });

  document.getElementById('import-config-btn')?.addEventListener('click', () => {
    (document.getElementById('import-config-input') as HTMLInputElement).click();
  });

  document.getElementById('import-config-input')?.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) {
      const text = await file.text();
      if (admin.importConfig(text)) {
        alert('配置导入成功！');
        loadCases();
      } else {
        alert('配置导入失败，请检查文件格式！');
      }
    }
  });

  document.getElementById('reset-config-btn')?.addEventListener('click', () => {
    if (confirm('确定要重置为默认配置吗？这将清除所有自定义配置！')) {
      admin.resetToDefault();
      loadCases();
      alert('已重置为默认配置！');
    }
  });

  document.getElementById('save-settings-btn')?.addEventListener('click', () => {
    const initialBalance = parseFloat((document.getElementById('initial-balance') as HTMLInputElement).value);
    const soundEnabled = (document.getElementById('sound-enabled') as HTMLInputElement).checked;
    const animationEnabled = (document.getElementById('animation-enabled') as HTMLInputElement).checked;

    storage.updateSettings({
      initialBalance,
      soundEnabled,
      animationEnabled
    });

    alert('设置已保存！');
  });

  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
      
      btn.classList.add('active');
      document.getElementById(`${(btn as HTMLElement).dataset.tab}-tab`)?.classList.add('active');
    });
  });

  loadCases();

  // 奖品管理功能
  (window as any).manageItems = (caseId: string) => {
    currentCaseId = caseId;
    const cases = storage.getCases();
    const caseItem = cases.find(c => c.id === caseId);
    
    if (!caseItem) return;
    
    (document.getElementById('items-case-name') as HTMLElement).textContent = `箱子: ${caseItem.name}`;
    loadItems(caseItem.items);
    
    (document.getElementById('items-modal') as HTMLElement).style.display = 'flex';
  };

  function loadItems(items: CaseItem[]) {
    const itemsList = document.getElementById('items-list') as HTMLElement;
    
    if (items.length === 0) {
      itemsList.innerHTML = `
        <div class="empty-state">
          <p>暂无奖品</p>
          <p class="hint">点击"添加奖品"开始配置</p>
        </div>
      `;
      return;
    }
    
    itemsList.innerHTML = items.map(item => `
      <div class="item-entry" data-id="${item.id}">
        <img src="${item.image}" alt="${item.name}"
             onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2260%22 height=%2260%22><rect fill=%22%230a0a0a%22 width=%2260%22 height=%2260%22/><text x=%2250%%22 y=%2250%%22 fill=%22%23888%22 text-anchor=%22middle%22 dy=%22.3em%22 font-size=%228%22>暂无图片</text></svg>'" />
        <div class="item-entry-info">
          <div class="item-entry-name" style="color: ${RarityColors[item.rarity]}">${item.name}</div>
          <div class="item-entry-details">
            ${RarityNames[item.rarity]} | ${item.type} | 概率: ${item.probability}% | 价格: $${item.price.toFixed(2)}
          </div>
        </div>
        <div class="item-entry-actions">
          <button class="btn-edit" onclick="editItem('${item.id}')">编辑</button>
          <button class="btn-delete" onclick="deleteItem('${item.id}')">删除</button>
        </div>
      </div>
    `).join('');
  }

  document.getElementById('add-item-btn')?.addEventListener('click', () => {
    editingItemId = null;
    (document.getElementById('item-modal-title') as HTMLElement).textContent = '添加奖品';
    (document.getElementById('item-form') as HTMLFormElement).reset();
    (document.getElementById('item-image-preview') as HTMLElement).innerHTML = '';
    (document.getElementById('item-inspect-image-preview') as HTMLElement).innerHTML = '';
    (document.getElementById('item-modal') as HTMLElement).style.display = 'flex';
  });

  document.getElementById('close-items-btn')?.addEventListener('click', () => {
    (document.getElementById('items-modal') as HTMLElement).style.display = 'none';
    loadCases();
  });

  document.getElementById('cancel-item-btn')?.addEventListener('click', () => {
    (document.getElementById('item-modal') as HTMLElement).style.display = 'none';
  });

  (window as any).editItem = (itemId: string) => {
    if (!currentCaseId) return;
    
    const cases = storage.getCases();
    const caseItem = cases.find(c => c.id === currentCaseId);
    if (!caseItem) return;
    
    const item = caseItem.items.find(i => i.id === itemId);
    if (!item) return;
    
    editingItemId = itemId;
    (document.getElementById('item-modal-title') as HTMLElement).textContent = '编辑奖品';
    
    (document.getElementById('item-name') as HTMLInputElement).value = item.name;
    (document.getElementById('item-type') as HTMLSelectElement).value = item.type;
    (document.getElementById('item-rarity') as HTMLSelectElement).value = item.rarity;
    (document.getElementById('item-probability') as HTMLInputElement).value = item.probability.toString();
    (document.getElementById('item-price') as HTMLInputElement).value = item.price.toString();
    (document.getElementById('item-collection') as HTMLInputElement).value = item.collection || '';
    (document.getElementById('item-image-url') as HTMLInputElement).value = item.image;
    (document.getElementById('item-inspect-image-url') as HTMLInputElement).value = item.inspectImage;
    
    const preview = document.getElementById('item-image-preview') as HTMLElement;
    preview.innerHTML = `<img src="${item.image}" alt="预览" style="max-width: 100px; max-height: 100px;" 
      onerror="this.style.display='none'" />`;
    
    const inspectPreview = document.getElementById('item-inspect-image-preview') as HTMLElement;
    inspectPreview.innerHTML = `<img src="${item.inspectImage}" alt="预览" style="max-width: 100px; max-height: 100px;"
      onerror="this.style.display='none'" />`;
    
    (document.getElementById('item-modal') as HTMLElement).style.display = 'flex';
  };

  (window as any).deleteItem = (itemId: string) => {
    if (!currentCaseId) return;
    
    if (confirm('确定要删除这个奖品吗？')) {
      admin.deleteItemFromCase(currentCaseId, itemId);
      
      const cases = storage.getCases();
      const caseItem = cases.find(c => c.id === currentCaseId);
      if (caseItem) {
        loadItems(caseItem.items);
      }
    }
  };

  document.getElementById('item-image')?.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) {
      const base64 = await admin.imageToBase64(file);
      const preview = document.getElementById('item-image-preview') as HTMLElement;
      preview.innerHTML = `<img src="${base64}" alt="预览" style="max-width: 100px; max-height: 100px;" />`;
      (document.getElementById('item-image-url') as HTMLInputElement).value = base64;
    }
  });

  document.getElementById('item-inspect-image')?.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) {
      const base64 = await admin.imageToBase64(file);
      const preview = document.getElementById('item-inspect-image-preview') as HTMLElement;
      preview.innerHTML = `<img src="${base64}" alt="预览" style="max-width: 100px; max-height: 100px;" />`;
      (document.getElementById('item-inspect-image-url') as HTMLInputElement).value = base64;
    }
  });

  document.getElementById('item-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    
    if (!currentCaseId) return;
    
    const name = (document.getElementById('item-name') as HTMLInputElement).value;
    const type = (document.getElementById('item-type') as HTMLSelectElement).value as CaseItem['type'];
    const rarity = (document.getElementById('item-rarity') as HTMLSelectElement).value as CaseItem['rarity'];
    const probability = parseFloat((document.getElementById('item-probability') as HTMLInputElement).value);
    const price = parseFloat((document.getElementById('item-price') as HTMLInputElement).value);
    const collection = (document.getElementById('item-collection') as HTMLInputElement).value;
    const image = (document.getElementById('item-image-url') as HTMLInputElement).value;
    const inspectImage = (document.getElementById('item-inspect-image-url') as HTMLInputElement).value;

    if (!image) {
      alert('请上传奖品图片或输入图片URL！');
      return;
    }

    if (editingItemId) {
      const updatedItem = admin.createItem(name, type, image, inspectImage || image, rarity, probability, price, collection);
      updatedItem.id = editingItemId;
      admin.updateItemInCase(currentCaseId, editingItemId, updatedItem);
    } else {
      const newItem = admin.createItem(name, type, image, inspectImage || image, rarity, probability, price, collection);
      admin.addItemToCase(currentCaseId, newItem);
    }

    (document.getElementById('item-modal') as HTMLElement).style.display = 'none';
    
    const cases = storage.getCases();
    const caseItem = cases.find(c => c.id === currentCaseId);
    if (caseItem) {
      loadItems(caseItem.items);
    }
  });

  const settings = storage.getUserData().settings;
  (document.getElementById('initial-balance') as HTMLInputElement).value = settings.initialBalance.toString();
  (document.getElementById('sound-enabled') as HTMLInputElement).checked = settings.soundEnabled;
  (document.getElementById('animation-enabled') as HTMLInputElement).checked = settings.animationEnabled;
</script>
